import cv2
from ultralytics import YOLO
import time
import torch
import os
import pandas as pd
import random
import threading
from queue import Queue

# -----------------------
# Configuration
# -----------------------
CAM_INDEXES = [0, 1, 2, 3]
CAM_NAMES = {
    0: "Cam 0",
    1: "Cam 1",
    2: "Cam 2",
    3: "Cam 3",
}
FRAME_WIDTH = 1280  # 720p width
FRAME_HEIGHT = 720  # 720p height
DISPLAY_WIDTH = 960  # 1/4 FHD width (1920/2)
DISPLAY_HEIGHT = 540  # 1/4 FHD height (1080/2)
CONF_THRESHOLD = 0.4  # confidence threshold for person detection
SAVE_INTERVAL_SEC = 10  # seconds between saving ROIs of the same person

# Load model once
# choose device (use CUDA if available)
device = "cuda" if torch.cuda.is_available() else "cpu"
print(f"Device selected: {device}")

model = YOLO("yolov8n.pt")
# move model to GPU if available
try:
    if device == "cuda":
        model.to("cuda")
except Exception:
    pass

# set model confidence threshold globally
try:
    model.conf = CONF_THRESHOLD
except Exception:
    pass

LOG_BASE_DIR = "logs"
ROI_BASE_DIR = os.path.join(LOG_BASE_DIR, "roi_images")

# Create base directories
os.makedirs(LOG_BASE_DIR, exist_ok=True)
os.makedirs(ROI_BASE_DIR, exist_ok=True)

# Thread-safe model lock for inference
model_lock = threading.Lock()

# Global flag to signal threads to stop
stop_event = threading.Event()


def distance(box1, box2):
    """Calculate distance between centers of two boxes."""
    cx1 = (box1[0] + box1[2]) / 2
    cy1 = (box1[1] + box1[3]) / 2
    cx2 = (box2[0] + box2[2]) / 2
    cy2 = (box2[1] + box2[3]) / 2
    return ((cx1 - cx2) ** 2 + (cy1 - cy2) ** 2) ** 0.5


def match_box_to_person(box, tracked_persons):
    """Find closest tracked person to this box."""
    min_dist = 100  # threshold
    matched_id = None

    for pid, pdata in tracked_persons.items():
        if "last_box" in pdata:
            dist = distance(box, pdata["last_box"])
            if dist < min_dist:
                min_dist = dist
                matched_id = pid

    return matched_id


class CameraThread(threading.Thread):
    """Thread class for handling each camera independently."""
    
    def __init__(self, cam_idx, cam_name, frame_queue, ready_event):
        super().__init__()
        self.cam_idx = cam_idx
        self.cam_name = cam_name
        self.frame_queue = frame_queue
        self.ready_event = ready_event
        self.daemon = True
        self.is_ready = False
        
        # Initialize camera
        self.cap = cv2.VideoCapture(cam_idx)
        self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, FRAME_WIDTH)
        self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, FRAME_HEIGHT)
        
        # Per-camera state
        self.tracked_persons = {}
        self.person_id_counter = 0
        self.used_ids = set()
        self.logs = []
        self.window_name = f"YOLO Person Detection ({cam_name})"
        self.roi_dir = os.path.join(ROI_BASE_DIR, f"cam{cam_idx}")
        self.log_dir = os.path.join(LOG_BASE_DIR, f"cam{cam_idx}")
        self.last_frame_time = None
        self.fps = 0.0
        self.process_every_n_frames = 2
        self.frame_counter = 0
        self.last_annotated_frame = None
        
        # Create directories
        os.makedirs(self.roi_dir, exist_ok=True)
        os.makedirs(self.log_dir, exist_ok=True)
    
    def run(self):
        """Main loop for camera thread."""
        # Wait for first frame to confirm camera is working
        ret = False
        for attempt in range(10):
            if stop_event.is_set():
                return
            ret, frame = self.cap.read()
            if ret:
                print(f"{self.cam_name}: Camera opened successfully!")
                self.is_ready = True
                self.ready_event.set()
                break
            time.sleep(0.5)
        
        if not ret:
            print(f"{self.cam_name}: Failed to open camera!")
            self.cap.release()
            return
        
        # Process the first frame
        frame_start = time.time()
        self.frame_counter += 1
        self.last_annotated_frame = frame.copy()
        
        # Add placeholder text
        cv2.putText(frame, f"People: 0", (20, 40), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 255), 2)
        cv2.putText(frame, f"FPS: 0.0", (20, 80), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255, 255, 0), 2)
        display_frame = cv2.resize(frame, (DISPLAY_WIDTH, DISPLAY_HEIGHT))
        try:
            if self.frame_queue.full():
                try:
                    self.frame_queue.get_nowait()
                except:
                    pass
            self.frame_queue.put_nowait((self.cam_idx, display_frame, self.window_name))
        except:
            pass
        
        # Main detection loop
        while not stop_event.is_set():
            if not self.cap.isOpened():
                break
            
            ret, frame = self.cap.read()
            if not ret:
                time.sleep(0.01)
                continue
            
            frame_start = time.time()
            
            # Increment frame counter and decide whether to run inference
            self.frame_counter += 1
            do_infer = (
                (self.frame_counter % self.process_every_n_frames == 0)
                or (self.last_annotated_frame is None)
            )
            
            person_count = 0
            
            if do_infer:
                # Run inference with thread-safe lock
                with model_lock:
                    try:
                        if device == "cuda":
                            from torch import amp
                            with amp.autocast(device_type="cuda"):
                                results = model(frame, verbose=False)
                        else:
                            results = model(frame, verbose=False)
                    except Exception:
                        results = model(frame, verbose=False)
                
                for box in results[0].boxes:
                    cls = int(box.cls[0])
                    conf = float(box.conf[0])
                    
                    # class 0 = person
                    if cls == 0 and conf > CONF_THRESHOLD:
                        person_count += 1
                        x1, y1, x2, y2 = map(int, box.xyxy[0])
                        current_box = (x1, y1, x2, y2)
                        
                        # Match with tracked person
                        matched_id = match_box_to_person(current_box, self.tracked_persons)
                        
                        if matched_id is not None:
                            # Update box position
                            self.tracked_persons[matched_id]["last_box"] = current_box
                            person_name = self.tracked_persons[matched_id].get(
                                "name", f"Person {matched_id}"
                            )
                            
                            # Check save interval
                            current_time = time.time()
                            last_save = self.tracked_persons[matched_id].get("last_save", 0)
                            
                            if person_name != f"Person {matched_id}" and current_time - last_save >= SAVE_INTERVAL_SEC:
                                roi = frame[y1:y2, x1:x2]
                                if roi.size > 0:
                                    person_folder = self.tracked_persons[matched_id]["folder"]
                                    filename = f"ID{person_name}_{int(current_time)}.jpg"
                                    filepath = os.path.join(person_folder, filename)
                                    cv2.imwrite(filepath, roi)
                                    
                                    self.tracked_persons[matched_id]["last_save"] = current_time
                                    
                                    self.logs.append({
                                        "time": time.strftime("%Y-%m-%d %H:%M:%S"),
                                        "person_id": person_name,
                                        "confidence": round(conf, 3),
                                        "roi_file": filepath,
                                    })
                                    print(f"{self.cam_name}: Saved ID {person_name} at {time.strftime('%H:%M:%S')}")
                        else:
                            # Create new person with random 3-digit ID
                            matched_id = self.person_id_counter
                            self.person_id_counter += 1
                            
                            while True:
                                random_id = f"{random.randint(0, 999):03d}"
                                if random_id not in self.used_ids:
                                    self.used_ids.add(random_id)
                                    break
                            
                            person_folder = os.path.join(self.roi_dir, random_id)
                            os.makedirs(person_folder, exist_ok=True)
                            
                            self.tracked_persons[matched_id] = {
                                "name": random_id,
                                "last_box": current_box,
                                "last_save": 0,
                                "folder": person_folder,
                            }
                            person_name = random_id
                            print(f"{self.cam_name}: New person detected! Assigned ID: {random_id}")
                        
                        # Draw box
                        color = (0, 255, 0)
                        label = f"ID:{person_name} conf:{conf:.2f}"
                        cv2.rectangle(frame, (x1, y1), (x2, y2), color, 2)
                        cv2.putText(
                            frame,
                            label,
                            (x1, y1 - 10),
                            cv2.FONT_HERSHEY_SIMPLEX,
                            0.5,
                            color,
                            2,
                        )
                
                # Overlay people count
                cv2.putText(
                    frame,
                    f"People: {person_count}",
                    (20, 40),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    1,
                    (0, 0, 255),
                    2,
                )
                
                # Cache annotated frame
                self.last_annotated_frame = frame.copy()
            else:
                # Use cached annotated frame if available
                if self.last_annotated_frame is not None:
                    frame = self.last_annotated_frame.copy()
                cv2.putText(
                    frame,
                    f"People: {len(self.tracked_persons)}",
                    (20, 40),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    1,
                    (0, 0, 255),
                    2,
                )
            
            # Compute FPS
            frame_end = time.time()
            if self.last_frame_time is not None:
                dt = frame_end - self.last_frame_time
                if dt > 0:
                    self.fps = 1.0 / dt
            self.last_frame_time = frame_end
            
            # Add FPS overlay
            cv2.putText(
                frame,
                f"FPS: {self.fps:.1f}",
                (20, 80),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,
                (255, 255, 0),
                2,
            )
            
            # Resize for display (1/4 FHD)
            display_frame = cv2.resize(frame, (DISPLAY_WIDTH, DISPLAY_HEIGHT))
            
            # Put frame in queue for main thread to display
            try:
                # Use non-blocking put, discard old frames if queue is full
                if self.frame_queue.full():
                    try:
                        self.frame_queue.get_nowait()
                    except:
                        pass
                self.frame_queue.put_nowait((self.cam_idx, display_frame, self.window_name))
            except:
                pass
        
        # Cleanup
        self.cap.release()
    
    def save_logs(self):
        """Save detection logs to CSV."""
        df = pd.DataFrame(self.logs)
        safe_name = "".join(c for c in self.cam_name if c.isalnum() or c in ("-", "_"))
        timestamp = time.strftime("%Y%m%d_%H%M%S")
        csv_filename = f"people_with_conf_and_roi_{safe_name or f'cam{self.cam_idx}'}_{timestamp}.csv"
        csv_path = os.path.join(self.log_dir, csv_filename)
        df.to_csv(csv_path, index=False)
        
        print(f"\n=== Session Summary ({self.cam_name}) ===")
        print(f"Total unique persons detected: {len(self.tracked_persons)}")
        print(f"Logs saved to {csv_path}")
        print("===============================")
        
        return csv_path


def main():
    print("=== Auto ID Assignment (4 Cams - Threaded) ===")
    print("Each detected person gets a random 3-digit ID automatically")
    print("ROIs saved every 10 seconds to roi_images/cam<idx>/<ID>/")
    print(f"Resolution: {FRAME_WIDTH}x{FRAME_HEIGHT} (720p)")
    print(f"Display: {DISPLAY_WIDTH}x{DISPLAY_HEIGHT} (1/4 FHD)")
    print("===============================================\n")
    print("Opening all cameras...\n")
    
    # Create frame queues and threads for each camera
    threads = []
    frame_queues = {}
    ready_events = {}
    
    for cam_idx in CAM_INDEXES:
        cam_name = CAM_NAMES.get(cam_idx, f"Cam {cam_idx}")
        frame_queue = Queue(maxsize=2)
        ready_event = threading.Event()
        frame_queues[cam_idx] = frame_queue
        ready_events[cam_idx] = ready_event
        
        thread = CameraThread(cam_idx, cam_name, frame_queue, ready_event)
        threads.append(thread)
        thread.start()
    
    # Wait for all cameras to be ready, showing windows as frames arrive
    print("Waiting for all cameras to be ready...\n")
    ready_status = {idx: False for idx in CAM_INDEXES}
    failed_status = {idx: False for idx in CAM_INDEXES}
    start_time = time.time()
    timeout_per_cam = 10  # seconds
    while not all(ready_status[idx] or failed_status[idx] for idx in CAM_INDEXES):
        for cam_idx, ready_event in ready_events.items():
            if not ready_status[cam_idx] and not failed_status[cam_idx]:
                if ready_event.is_set():
                    print(f"✓ {CAM_NAMES.get(cam_idx, f'Cam {cam_idx}')} ready")
                    ready_status[cam_idx] = True
                elif time.time() - start_time > timeout_per_cam:
                    print(f"✗ {CAM_NAMES.get(cam_idx, f'Cam {cam_idx}')} FAILED to open")
                    failed_status[cam_idx] = True
        # Show all available frames
        for fq_idx, frame_queue in frame_queues.items():
            try:
                if not frame_queue.empty():
                    _, frame, window_name = frame_queue.get_nowait()
                    cv2.imshow(window_name, frame)
            except:
                pass
        key = cv2.waitKey(30) & 0xFF
        if key == ord("q"):
            print("\nQuitting...")
            stop_event.set()
            for thread in threads:
                thread.join(timeout=2.0)
            cv2.destroyAllWindows()
            return
    if not all(ready_status[idx] for idx in CAM_INDEXES):
        print("\nNot all cameras opened successfully. Stopping...")
        stop_event.set()
        for thread in threads:
            thread.join(timeout=2.0)
        cv2.destroyAllWindows()
        return
    print("\n=== All cameras ready! Starting detection ===")
    print("Press 'q' to quit")
    print("=" * 44 + "\n")
    
    try:
        while not stop_event.is_set():
            # Display frames from all cameras
            for cam_idx, frame_queue in frame_queues.items():
                try:
                    if not frame_queue.empty():
                        _, frame, window_name = frame_queue.get_nowait()
                        cv2.imshow(window_name, frame)
                except:
                    pass
            
            # Check for quit key
            key = cv2.waitKey(30) & 0xFF
            if key == ord("q"):
                print("\nQuitting...")
                stop_event.set()
                break
            
            # Check if all threads are still alive
            alive_threads = [t for t in threads if t.is_alive()]
            if len(alive_threads) == 0:
                print("\nAll camera threads stopped.")
                break
    
    except KeyboardInterrupt:
        print("\nInterrupted by user (KeyboardInterrupt)")
        stop_event.set()
    
    # Wait for all threads to finish
    for thread in threads:
        thread.join(timeout=2.0)
    
    # Close all OpenCV windows
    cv2.destroyAllWindows()
    
    # Save logs for each camera
    for thread in threads:
        thread.save_logs()
    
    print("\n=== All cameras stopped ===")


if __name__ == "__main__":
    main()
